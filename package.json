{
  "name": "@flex-development/mdast-util-from-markdown",
  "description": "mdast utility to parse markdown",
  "version": "2.0.0",
  "keywords": [
    "ast",
    "markdown",
    "markup",
    "mdast",
    "mdast-util",
    "parse",
    "syntax",
    "tree",
    "unist",
    "util",
    "utility"
  ],
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/flex-development/mdast-util-from-markdown",
  "repository": "https://github.com/flex-development/mdast-util-from-markdown.git",
  "bugs": "https://github.com/flex-development/mdast-util-from-markdown/issues",
  "author": {
    "name": "Lexus Drumgold",
    "url": "https://github.com/unicornware"
  },
  "publishConfig": {
    "access": "public",
    "diff-dst-prefix": "mdast-util-from-markdown",
    "diff-src-prefix": "mdast-util-from-markdown",
    "directory": "./",
    "executableFiles": [],
    "node-options": null,
    "pack-destination": ".",
    "parseable": true,
    "prefer-dedupe": true,
    "provenance": true,
    "tag-version-prefix": ""
  },
  "type": "module",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "mdast-util-from-markdown": "./src/index.mts",
      "default": "./dist/index.mjs"
    },
    "./creators": {
      "mdast-util-from-markdown": "./src/creators.mts",
      "default": "./dist/creators.mjs"
    },
    "./handles": {
      "mdast-util-from-markdown": "./src/handles.mts",
      "default": "./dist/handles.mjs"
    },
    "./package.json": "./package.json",
    "./mdast": {
      "mdast-util-from-markdown": "./src/mdast.mts",
      "default": "./dist/mdast.d.mts"
    }
  },
  "imports": {
    "#fixtures/*": "./__fixtures__/*.mts",
    "#tests/*": "./__tests__/*.mts",
    "#types/*": {
      "mdast-util-from-markdown": "./src/types/index.mts",
      "default": "./dist/types/index.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "remarkConfig": {
    "plugins": [
      "@flex-development/remark-preset"
    ]
  },
  "scripts": {
    "build": "yarn clean:build && tsc -p tsconfig.build.json --noEmit false && rollup -c=rollup.config.mts && trash dist/** \"!dist/mdast.d.mts\" \"!dist/{creators,handles,index}.{d.mts,mjs}\"",
    "check:ci": "yarn dedupe --check && yarn check:format && yarn check:lint && yarn check:spelling && yarn typecheck && yarn check:types && yarn test:cov && attw --pack && yarn check:types:build",
    "check:format": "dprint check --incremental=false",
    "check:lint": "eslint --exit-on-fatal-error --max-warnings 0 .",
    "check:spelling": "cspell lint --color --no-progress --relative $@ \"**\"",
    "check:types": "tsc -p tsconfig.json",
    "check:types:build": "tsc -p tsconfig.build.json",
    "check:upgrades": "yarn upgrade-interactive",
    "clean:build": "trash \"./{dist,*.tgz}\" || exit 0",
    "clean:modules": "trash ./.yarn/{cache,*.gz} ./node_modules",
    "clean:pack": "trash \"./*.tgz\"",
    "clean:test": "trash ./coverage && trash __tests__/reports",
    "codecov": "yarn test:cov && yarn test:cov:upload",
    "codecov:validate": "cat .codecov.yml | curl --data-binary @- https://codecov.io/validate",
    "commitlint": "commitlint -V",
    "fix:cg": "yarn fix:format && yarn fix:lint",
    "fix:dedupe": "yarn dedupe --strategy=highest",
    "fix:format": "dprint fmt",
    "fix:lint": "yarn check:lint --cache --fix",
    "postinstall": "[ -f ./.git ] && [ -f ./node_modules/.bin/husky ] && chmod +x .husky/_/* && husky || exit 0",
    "postpack": "toggle-scripts +postinstall",
    "postpublish": "toggle-scripts +prepack",
    "prepack": "toggle-scripts -postinstall && yarn build",
    "prepublishOnly": "toggle-scripts -prepack",
    "release": "bash ./scripts/release.sh",
    "remark": "remark .",
    "test": "yarn clean:build; vitest run",
    "test:cov": "yarn test --coverage",
    "test:cov:reports": "yarn test:cov --merge-reports --mode=reports",
    "test:cov:ui": "yarn test:ui --coverage",
    "test:cov:upload": "./codecov -t $CODECOV_TOKEN -f ./coverage/lcov.info",
    "test:reports": "yarn test --merge-reports --mode=reports",
    "test:ui": "cross-env VITEST_UI=1 vitest --ui",
    "typecheck": "yarn test --typecheck --mode=typecheck",
    "typecheck:ui": "yarn test:ui --typecheck --mode=typecheck"
  },
  "dependencies": {
    "@flex-development/mark": "1.0.0-alpha.12",
    "@flex-development/mark-compiler": "1.0.0-alpha.10",
    "@flex-development/unist-util-builder": "2.0.0",
    "@types/mdast": "4.0.4",
    "decode-named-character-reference": "1.3.0",
    "devlop": "1.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark": "4.0.3",
    "micromark-util-decode-numeric-character-reference": "2.0.2",
    "micromark-util-decode-string": "2.0.1",
    "micromark-util-normalize-identifier": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@codecov/rollup-plugin": "2.0.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@edge-runtime/vm": "5.0.0",
    "@flex-development/commitlint-config": "1.0.1",
    "@flex-development/eslint-config": "1.1.1",
    "@flex-development/export-regex": "2.0.0",
    "@flex-development/grease": "3.0.0-alpha.9",
    "@flex-development/import-regex": "3.0.0",
    "@flex-development/pathe": "4.0.2",
    "@flex-development/remark-preset": "1.0.0",
    "@flex-development/tutils": "6.0.0-alpha.25",
    "@flex-development/unist-util-inspect": "1.1.0",
    "@flex-development/unist-util-types": "1.6.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@tsconfig/strictest": "2.0.8",
    "@types/concat-stream": "2.0.3",
    "@types/debug": "4.1.13",
    "@types/hast": "3.0.5",
    "@types/is-ci": "3.0.4",
    "@types/node-notifier": "8.0.5",
    "@types/rollup": "0.54.0",
    "@types/unist": "3.0.3",
    "@vates/toggle-scripts": "1.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "commonmark.json": "0.31.0",
    "concat-stream": "2.0.0",
    "convert-hrtime": "5.0.0",
    "cross-env": "10.1.0",
    "cspell": "10.4.0",
    "dprint": "0.64.3",
    "editorconfig": "3.0.2",
    "eslint": "9.39.5",
    "growl": "1.10.5",
    "happy-dom": "21.0.4",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-hast": "13.2.1",
    "node-notifier": "11.0.0",
    "pkg-size": "2.4.0",
    "remark": "15.0.1",
    "remark-cli": "12.0.1",
    "rollup": "4.65.1",
    "rollup-plugin-cleanup": "3.2.1",
    "rollup-plugin-dts": "6.5.1",
    "sh-syntax": "0.7.0",
    "to-vfile": "8.0.0",
    "trash-cli": "7.2.0",
    "ts-dedent": "2.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vfile": "6.0.3",
    "vfile-find-down": "7.1.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "resolutions": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3"
  },
  "packageManager": "yarn@4.18.1",
  "sideEffects": false
}
